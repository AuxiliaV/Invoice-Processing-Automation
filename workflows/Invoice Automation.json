    {
      "parameters": {
        "jsCode": "const newItems = [];\n\nfor (const item of $input.all()) {\n  const attachmentKeys = Object.keys(item.binary || {});\n\n  for (const key of attachmentKeys) {\n    const file = item.binary[key];\n\n    // Skip anything that isn't a PDF (e.g. an embedded logo image in the email signature)\n    if (file.mimeType !== 'application/pdf') continue;\n\n    newItems.push({\n      json: item.json,        // keep the email's subject/from/date info\n      binary: { data: file }, // always name it \"data\", regardless of the original name\n    });\n  }\n}\n\nreturn newItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -96,
