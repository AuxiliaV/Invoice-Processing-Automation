    {
      "parameters": {
        "jsCode": "const normalize = (val) => String(val ?? '').trim();\n\nconst existingInvoiceNumbers = $input.all()\n  .map(row => normalize(row.json.invoice_number))\n  .filter(Boolean);\n\nconst originalItems = $('Information Extractor').all();\n\nreturn originalItems.map(item => {\n  const extracted = item.json.output; // the actual extracted invoice fields live one level deeper, here\n  const thisInvoiceNumber = normalize(extracted.invoice_number);\n\n  return {\n    json: {\n      ...extracted,  // spread the real fields (vendor_name, invoice_number, total_amount, etc.) flat\n      is_duplicate: existingInvoiceNumbers.includes(thisInvoiceNumber),\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
